<launch>
  <arg name="interface" default="can0"/>
  <arg name="node_id" default="8"/>
  <arg name="frame_id" default="imu_link"/>
  <arg name="params_file" default="$(find hipnuc_imu)/config/can.yaml"/>
  <node pkg="hipnuc_imu" type="can_node" name="hipnuc_can" output="screen">
    <rosparam command="load" file="$(arg params_file)"/>
    <param name="interface" value="$(arg interface)"/>
    <param name="node_id" value="$(arg node_id)"/>
    <param name="frame_id" type="str" value="$(arg frame_id)"/>
  </node>
</launch>
